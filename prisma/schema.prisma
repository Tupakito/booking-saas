generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// BUSINESS (Profil professionnel)
// ============================================

model Business {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  email       String   @unique
  password    String?
  phone       String?
  address     String?
  city        String?
  zipCode     String?  @map("zip_code")
  logoUrl     String?  @map("logo_url")
  website     String?
  isActive    Boolean  @default(true) @map("is_active")
  
  // Stripe (S2)
  stripeAccountId   String? @unique @map("stripe_account_id")
  stripeOnboarding  Boolean @default(false) @map("stripe_onboarding")
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  services Service[]
  bookings Booking[]
  settings BusinessSettings?

  @@index([slug])
  @@index([isActive])
  @@map("businesses")
}

// ============================================
// BUSINESS SETTINGS
// ============================================

model BusinessSettings {
  id         String @id @default(cuid())
  businessId String @unique @map("business_id")
  
  // Notification preferences
  emailNotifications Boolean @default(true) @map("email_notifications")
  smsNotifications   Boolean @default(false) @map("sms_notifications")
  
  // Booking settings
  minBookingNotice    Int     @default(60) @map("min_booking_notice") // minutes
  maxBookingAdvance   Int     @default(30) @map("max_booking_advance") // days
  allowSameDayBooking Boolean @default(true) @map("allow_same_day_booking")
  
  // Cancellation policy
  cancellationPolicy  String? @map("cancellation_policy") @db.Text
  cancellationHours   Int     @default(24) @map("cancellation_hours")
  
  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

// ============================================
// SERVICES (Prestations)
// ============================================

model Service {
  id          String  @id @default(cuid())
  businessId  String  @map("business_id")
  name        String
  description String? @db.Text
  duration    Int     // minutes
  price       Int     // cents
  currency    String  @default("EUR")
  color       String? // hex color
  isActive    Boolean @default(true) @map("is_active")
  
  // Buffer time between appointments
  bufferTime  Int     @default(0) @map("buffer_time") // minutes
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  slots    Slot[]
  bookings Booking[]

  @@index([businessId])
  @@index([isActive])
  @@map("services")
}

// ============================================
// SLOTS (Disponibilités récurrentes)
// ============================================

model Slot {
  id        String @id @default(cuid())
  serviceId String @map("service_id")
  dayOfWeek Int    @map("day_of_week") // 0-6 (Dimanche-Samedi)
  startTime String @map("start_time")  // Format "HH:MM"
  endTime   String @map("end_time")    // Format "HH:MM"
  
  // Optional: specific date override (for exceptions)
  specificDate DateTime? @map("specific_date")
  
  // Is this slot available for booking?
  isAvailable Boolean @default(true) @map("is_available")

  // Relations
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
  @@index([dayOfWeek])
  @@index([specificDate])
  @@map("slots")
}

// ============================================
// BOOKINGS (Réservations)
// ============================================

model Booking {
  id            String        @id @default(cuid())
  businessId    String        @map("business_id")
  serviceId     String        @map("service_id")
  
  // Customer info
  customerName  String        @map("customer_name")
  customerEmail String        @map("customer_email")
  customerPhone String?       @map("customer_phone")
  
  // Appointment time
  startTime     DateTime      @map("start_time")
  endTime       DateTime      @map("end_time")
  
  // Status
  status        BookingStatus @default(CONFIRMED)
  
  // Payment
  amount        Int           // cents, copied from service at booking time
  currency      String        @default("EUR")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  
  // Stripe (S2)
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  
  // Notes
  notes         String?       @db.Text
  internalNotes String?       @map("internal_notes") @db.Text // For business eyes only
  
  // Cancellation
  cancelledAt   DateTime?     @map("cancelled_at")
  cancelReason  String?       @map("cancel_reason")
  
  // Reminders sent
  reminderSent  Boolean       @default(false) @map("reminder_sent")
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([serviceId])
  @@index([startTime])
  @@index([status])
  @@index([customerEmail])
  @@map("bookings")
}

// ============================================
// ENUMS
// ============================================

enum BookingStatus {
  CONFIRMED
  CANCELLED
  NO_SHOW
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}