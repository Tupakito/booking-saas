```bash
# ============================================
# Configuration de l'application
# ============================================

# URL de l'application (en prod: https://votre-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Clé secrète pour NextAuth (générer avec: openssl rand -base64 32)
# MINIMUM 32 CARACTERES REQUIS
NEXTAUTH_SECRET="change-me-in-production-min-32-chars-long-secret-key"

# ============================================
# Base de données PostgreSQL
# ============================================

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/booking_saas"

# ============================================
# OAuth Google (optionnel)
# ============================================

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
```