```bash
# ============================================
# Configuration de l'application
# ============================================

# URL de l'application (en prod: https://votre-app.vercel.app)
NEXTAUTH_URL="http://localhost:3000"

# Clé secrète pour NextAuth (générer avec: openssl rand -base64 32)
# MINIMUM 32 CARACTERES REQUIS
NEXTAUTH_SECRET="votre-cle-super-secrete-de-32-caracteres-min"

# ============================================
# Base de données PostgreSQL
# ============================================

# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Pour Vercel Postgres: postgresql://neondb_owner:PASSWORD@HOST-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/booking_saas"

# ============================================
# OAuth Google (optionnel)
# ============================================

# 1. Créer un projet sur https://console.cloud.google.com/
# 2. Activer l'API Google+ ou People API
# 3. Créer des identifiants OAuth 2.0
# 4. Ajouter l'URL de redirection: https://votre-app.vercel.app/api/auth/callback/google

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
```