# ============================================
# RENDEZ MVP - ENVIRONMENT VARIABLES
# ============================================

# --------------------------------------------
# DATABASE (Required)
# --------------------------------------------
# Neon PostgreSQL connection string
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/booking-saas?sslmode=require"

# --------------------------------------------
# AUTHENTICATION (Required)
# --------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-min-32-characters-long"
NEXTAUTH_URL="http://localhost:3000"

# --------------------------------------------
# OAUTH (Optional - for Google login)
# --------------------------------------------
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --------------------------------------------
# EMAIL (Optional for S1, Required for S2)
# --------------------------------------------
# Get from: https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxx"

# --------------------------------------------
# PAYMENT (Optional - S2 only)
# --------------------------------------------
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_xxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxx"
STRIPE_CONNECT_CLIENT_ID="ca_xxxxxxxx"

# --------------------------------------------
# APP CONFIG
# --------------------------------------------
APP_URL="http://localhost:3000"
APP_NAME="Rendez"